      "text": "You can decide to publish a secret. You can never decide to un-publish one.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "You can decide to publish a secret. You can never decide to un-publish one.",
      "lineHeight": 1.25,
      "baseline": 16
    },

      "text": "thin \u00b7 thin \u00b7 thin \u00b7 thin \u2014 necessary steps where you have no bargaining power,\nbecause the customer could do them, or buy them from eleven other people.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "thin \u00b7 thin \u00b7 thin \u00b7 thin \u2014 necessary steps where you have no bargaining power,\nbecause the customer could do them, or buy them from eleven other people.",
      "lineHeight": 1.25,
      "baseline": 14
    },

      "text": "THE CHOKEPOINT \u2014 margin pools here\nauthentication is what the customer is actually buying",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE CHOKEPOINT \u2014 margin pools here\nauthentication is what the customer is actually buying",

      },
      "text": "The test is roughly the right and ability to control, plus a direct financial benefit.\nIt reaches a partner who never owned you.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The test is roughly the right and ability to control, plus a direct financial benefit.\nIt reaches a partner who never owned you.",
      "lineHeight": 1.25,
      "baseline": 14
    },

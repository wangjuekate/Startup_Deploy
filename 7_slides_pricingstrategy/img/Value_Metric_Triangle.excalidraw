      },
      "text": "The LEVEL is easy to change and cheap to get wrong.\nThe METRIC is almost impossible to change, and it decides your entire company.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The LEVEL is easy to change and cheap to get wrong.\nThe METRIC is almost impossible to change, and it decides your entire company.",
      "lineHeight": 1.25,
      "baseline": 16
    },
    {
      "id": "asymn",
      "type": "text",
      "x": 60,
      "y": 632,
      "width": 1040,
      "height": 66,
      "angle": 0,
      "strokeColor": "#4b5563",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

      "seed": 1342652864,
      "version": 1,
      "versionNonce": 760089498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "beat": 4
      },
      "text": "And a usage metric aligns you with your customer's SUCCESS \u2014 and with your customer's EFFICIENCY.\nWhen the customer grows, you grow. When the customer optimizes, you shrink.\nYou signed up for both when you picked the metric, and you cannot have only the first half.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "And a usage metric aligns you with your customer's SUCCESS \u2014 and with your customer's EFFICIENCY.\nWhen the customer grows, you grow. When the customer optimizes, you shrink.\nYou signed up for both when you picked the metric, and you cannot have only the first half.",
      "lineHeight": 1.25,
      "baseline": 14
    }

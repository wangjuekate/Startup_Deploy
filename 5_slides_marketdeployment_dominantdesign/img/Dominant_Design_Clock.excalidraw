      "link": null,
      "locked": false,
      "customData": {
        "beat": 5
      },
      "text": "Openness is a weapon while the standard is being decided, and a giveaway once it is settled \u2014\nsame action, opposite value, and the only thing that changed was the gate.\nAnd winning Gate 2 hands you a business that is about to commoditize: the victory and the margin compression are the SAME EVENT.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Openness is a weapon while the standard is being decided, and a giveaway once it is settled \u2014\nsame action, opposite value, and the only thing that changed was the gate.\nAnd winning Gate 2 hands you a business that is about to commoditize: the victory and the margin compression are the SAME EVENT.",
      "lineHeight": 1.25,
      "baseline": 14
    }
